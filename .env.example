# Cấu hình cho codebase/ai.py ở thư mục gốc, không phải các dịch vụ Docker trong vintrip/.
# Chép thành .env và giữ file .env trên máy. Không commit khóa hoặc chụp khóa lên video.
# fake ép chạy offline-deterministic, token 0. Đổi thành openai khi muốn gọi API thật.
# Thiếu OPENAI_API_KEY thì code cũng chạy offline. Không dùng lượt offline làm bằng chứng AI thật.
MODEL_PROVIDER=fake
OPENAI_API_KEY=
# Để trống dùng model mặc định trong code; điền mã model được tài khoản/endpoint của nhóm hỗ trợ.
OPENAI_MODEL=
# Để trống dùng https://api.openai.com/v1. Nếu dùng endpoint riêng, phải xác nhận model và giá ở đó.
OPENAI_BASE_URL=
