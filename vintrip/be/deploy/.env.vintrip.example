# Chép thành deploy/.env.vintrip và dùng --env-file deploy/.env.vintrip.
PG_PORT=5432
REDIS_PORT=6379
LOG_LEVEL=info
AI_LOG_LEVEL=INFO

# Bật LLM khi có khóa OpenAI. Cả controller và responder dùng gpt-4o-mini.
CHAT_LLM_ENABLED=false
OPENAI_API_KEY=
CHAT_IDENTITY_SALT=
CHAT_SYSTEM_DAILY_USD=3

# Room Upgrades Copilot (C2-CP2): OpenAI Responses API với gpt-6-luna (tách riêng khỏi chat C1/C3).
ROOM_UPGRADES_LLM_ENABLED=true
ROOM_UPGRADES_LLM_PROVIDER=openai
ROOM_UPGRADES_LLM_MODEL=gpt-6-luna
ROOM_UPGRADES_LLM_REASONING_EFFORT=low
ROOM_UPGRADES_LLM_TIMEOUT_SECONDS=30
ROOM_UPGRADES_LLM_MAX_CALLS=5
ROOM_UPGRADES_LLM_MAX_REPAIRS=2

# Tích hợp tùy chọn cho media và kiểm duyệt.
DEV_NAME=vintrip
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MEDIA_CDN_URL=
MODERATION_SERVICE_CLIENT_SECRET=

# Worker tóm tắt chỉ chạy với profile extra.
LLM_PROVIDER=fake
DEEPSEEK_API_KEY=
SERVICE_CLIENT_SECRET=
